#!/bin/bash
# Run Claude Code from Docker in the current working directory

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$SCRIPT_DIR/config" 2>/dev/null || source "$SCRIPT_DIR/config.in"

# Check current directory is under WORK_ROOT
if [[ "$PWD" != "$WORK_ROOT"* ]]; then
  echo "Error: must be run from within $WORK_ROOT" >&2
  exit 1
fi

# Determine entrypoint based on script name
case "$(basename "$0")" in
  claude-docker-npx) CMD=(--entrypoint npx) ;;
  claude-docker-bash) CMD=(--entrypoint bash) ;;
  codex-docker) CMD=() ; set -- codex "$@" ;;
  *) CMD=() ; set -- claude "$@" ;;
esac

# Mount /etc/alternatives if it exists (Debian/Ubuntu symlinks used by /usr binaries)
ALTERNATIVES=()
[[ -d /etc/alternatives ]] && ALTERNATIVES=(-v /etc/alternatives:/etc/alternatives:ro)

# Ensure mount targets exist so Docker doesn't create them as root-owned directories
[[ -d "$HOME/.claude" ]] || mkdir -p "$HOME/.claude"
[[ -f "$HOME/.claude.json" ]] || touch "$HOME/.claude.json"
[[ -d "$HOME/.codex" ]] || mkdir -p "$HOME/.codex"

# D-Bus: expose only desktop notifications from the host session bus, through a
# filtering proxy. The full bus would let the container run host commands
# (systemd --user, Flatpak HostCommand) and read the keyring. Use scoped
# --call/--broadcast rules, not --talk: --talk opens every object on the
# notification server's connection, which some desktops share with other services.
DBUS_DOCKER_ARGS=()
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v xdg-dbus-proxy >/dev/null &&
   DBUS_PROXY_DIR="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/claude-docker-dbus.XXXXXX")"; then
  trap 'rm -rf "$DBUS_PROXY_DIR"' EXIT
  # The proxy writes one byte to the pipe when ready, and exits once this
  # script (and docker) close the read end.
  exec {DBUS_PROXY_FD}< <(exec xdg-dbus-proxy --fd=1 \
    "$DBUS_SESSION_BUS_ADDRESS" "$DBUS_PROXY_DIR/bus" \
    --filter \
    --call=org.freedesktop.Notifications=org.freedesktop.Notifications.*@/org/freedesktop/Notifications \
    --broadcast=org.freedesktop.Notifications=org.freedesktop.Notifications.*@/org/freedesktop/Notifications)
  if read -r -n 1 -t 5 -u "$DBUS_PROXY_FD" && [[ -S $DBUS_PROXY_DIR/bus ]]; then
    DBUS_DOCKER_ARGS=(
      -v "$DBUS_PROXY_DIR/bus:/run/user/$(id -u)/bus"
      -e "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus"
    )
  else
    exec {DBUS_PROXY_FD}<&-
    echo "Warning: xdg-dbus-proxy did not start; desktop notifications disabled" >&2
  fi
fi

# Per-run Docker options. Split on whitespace without evaluating shell syntax.
ENV_DOCKER_ARGS=()
if [[ -n ${CLAUDE_DOCKER_EXTRA_ARGS:-} ]]; then
  if [[ $CLAUDE_DOCKER_EXTRA_ARGS == *$'\n'* ]]; then
    echo "Error: CLAUDE_DOCKER_EXTRA_ARGS must be a single line" >&2
    exit 1
  fi
  IFS=$' \t\n' read -r -a ENV_DOCKER_ARGS <<< "$CLAUDE_DOCKER_EXTRA_ARGS"
fi

docker --context rootless run -it --rm --security-opt no-new-privileges \
  --user 0:0 \
  -e HOME="$HOME" \
  -e IS_SANDBOX=1 \
  -w "$PWD" \
  -v "$WORK_ROOT:$WORK_ROOT" \
  -v "$HOME/.claude:$HOME/.claude" \
  -v "$HOME/.claude.json:$HOME/.claude.json" \
  -v "$HOME/.codex:$HOME/.codex" \
  -v "$HOME/.agents:$HOME/.agents" \
  -v /usr:/usr:ro \
  "${ALTERNATIVES[@]}" \
  "${DBUS_DOCKER_ARGS[@]}" \
  "${EXTRA_DOCKER_ARGS[@]}" \
  "${ENV_DOCKER_ARGS[@]}" \
  "${CMD[@]}" claude-docker "$@"
