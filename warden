#!/bin/bash
# warden: run coding agents from Docker in the current working directory
#   warden [options] claude|codex|opencode|bash|npx [args...]
#   warden [--context NAME] build [--full] [--base-image IMAGE]

set -e

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# Defaults, used when the matching option is not given. Edit to change them.
DEFAULT_CONTEXT=rootless   # --context: rootless | native
DEFAULT_RUNTIME=runc       # --runtime: runc | runsc (gVisor)
DEFAULT_WORK_ROOT=""       # --work-root: empty allows any folder
DEFAULT_GPU=""             # --gpu: set to 1 to always pass GPU devices
DEFAULT_UV=1               # --uv / --no-uv: mount host uv (skipped if not installed)

usage() {
  echo "Usage: warden [options] <claude|codex|opencode|bash|npx> [args...]"
  echo "       warden [--context NAME] build [--full] [--base-image IMAGE]"
}

help() {
  cat <<EOF
warden - run coding agents in a Docker sandbox, in the current project folder

$(usage)

Tools (each mounts only its own config and logins):
  claude      Claude Code      ~/.claude, ~/.claude.json, ~/.config/ccstatusline
  codex       OpenAI Codex     ~/.codex
  opencode    OpenCode         ~/.config/opencode, plus container-only data
  bash        shell            all of the above, to switch agents inside
  npx         npx              all of the above
Every run also mounts the project (rw), ~/.agents (rw) and /usr (ro).

Options:
  --context rootless|native   Docker daemon (default: $DEFAULT_CONTEXT)
                                rootless  your per-user daemon, no root
                                native    Docker's system daemon, runs as root
  --runtime runc|runsc        container runtime (default: $DEFAULT_RUNTIME)
                                runc      plain Docker
                                runsc     gVisor sandbox, slower but more isolated
  --work-root DIR             only allow launches under DIR (default: ${DEFAULT_WORK_ROOT:-any folder})
  --docker-args 'FLAGS'       extra docker run flags, e.g. '-e OPENAI_API_KEY'
                              (repeatable; split on spaces, no shell quoting)
  --gpu                       pass NVIDIA and /dev/dri devices; always uses runc
  --uv, --no-uv               mount host uv, its Pythons and cache: ~/.local/share/uv,
                              ~/.cache/uv, ~/.config/uv (ro) (default: on if installed)

Examples:
  warden claude --resume
  warden --runtime runsc claude      run inside gVisor
  warden codex login --device-auth
  warden opencode run "explain this project"
  warden --docker-args '-p 8080:8080' bash
  warden build --full          rebuild without cache
  warden build --base-image debian:bookworm
EOF
}

set_opt() {
  [[ -n $2 ]] || { echo "Error: $1 needs a value" >&2; exit 1; }
  case $1 in
    --context) DOCKER_CONTEXT="$2" ;;
    --runtime) DOCKER_RUNTIME="$2"; RUNTIME_SET=1 ;;
    --work-root) WORK_ROOT="$2" ;;
    --docker-args) DOCKER_ARGS+=" $2" ;;
  esac
}

DOCKER_CONTEXT="$DEFAULT_CONTEXT" DOCKER_RUNTIME="$DEFAULT_RUNTIME" WORK_ROOT="$DEFAULT_WORK_ROOT"
GPU="$DEFAULT_GPU" UV="$DEFAULT_UV" RUNTIME_SET=""
DOCKER_ARGS="${CLAUDE_DOCKER_EXTRA_ARGS:-}"
while [[ $# -gt 0 ]]; do
  case $1 in
    --context|--runtime|--work-root|--docker-args) set_opt "$1" "${2:-}"; shift 2 ;;
    --context=*|--runtime=*|--work-root=*|--docker-args=*) set_opt "${1%%=*}" "${1#*=}"; shift ;;
    --gpu) GPU=1; shift ;;
    --uv) UV=required; shift ;;
    --no-uv) UV=""; shift ;;
    --) shift; break ;;
    *) break ;;
  esac
done
# "native" is Docker's own system daemon, which Docker calls "default".
[[ $DOCKER_CONTEXT != native ]] || DOCKER_CONTEXT=default

TOOL="${1:-}"
[[ $# -eq 0 ]] || shift
case "$TOOL" in
  claude|codex|opencode) CMD=(); set -- "$TOOL" "$@" ;;
  bash|npx) CMD=(--entrypoint "$TOOL") ;;
  build) WARDEN_DOCKER_CONTEXT="$DOCKER_CONTEXT" exec "$SCRIPT_DIR/warden-build" "$@" ;;
  -h|--help|help) help; exit 0 ;;
  *) { usage; echo "Run 'warden --help' for details."; } >&2; exit 1 ;;
esac

# Check current directory is under WORK_ROOT (default: any folder)
WORK_ROOT="$(realpath -e "${WORK_ROOT:-$PWD}")"
WORK_DIR="$(pwd -P)"
if [[ "$WORK_DIR" == / || "$WORK_DIR" == "$(realpath -e "$HOME")" ]]; then
  echo "Error: choose a project directory, not / or your home directory" >&2
  exit 1
fi
if [[ "$WORK_DIR" != "$WORK_ROOT" && "$WORK_DIR" != "${WORK_ROOT%/}/"* ]]; then
  echo "Error: must be run from within $WORK_ROOT" >&2
  exit 1
fi

# Rootless container root maps to the host user; rootful Docker needs our UID.
SECURITY_OPTIONS="$(docker --context "$DOCKER_CONTEXT" info --format '{{json .SecurityOptions}}')"
CONTAINER_USER="$(id -u):$(id -g)"
CAP_ARGS=(--cap-drop ALL)
if [[ "$SECURITY_OPTIONS" == *rootless* ]]; then
  # Container root must still read the image's UID-owned home (mode 750). Inside
  # the user namespace this only applies to files owned by mapped IDs.
  CONTAINER_USER=0:0
  CAP_ARGS+=(--cap-add DAC_OVERRIDE)
fi

# Mount /etc/alternatives if it exists (Debian/Ubuntu symlinks used by /usr binaries)
ALTERNATIVES=()
[[ -d /etc/alternatives ]] && ALTERNATIVES=(-v /etc/alternatives:/etc/alternatives:ro)

# Mount only the selected agent's config and credentials, so one agent cannot read
# another's login; bash and npx get all of them to allow switching inside.
# Create mount sources first so Docker doesn't create them as root-owned directories.
uses() { [[ $TOOL == "$1" || $TOOL == bash || $TOOL == npx ]]; }
mkdir -p "$HOME/.agents"
AGENT_ARGS=(-v "$HOME/.agents:$HOME/.agents")
if uses claude; then
  mkdir -p "$HOME/.claude" "$HOME/.config/ccstatusline"
  [[ -f "$HOME/.claude.json" ]] || touch "$HOME/.claude.json"
  AGENT_ARGS+=(
    -v "$HOME/.claude:$HOME/.claude"
    -v "$HOME/.claude.json:$HOME/.claude.json"
    -v "$HOME/.config/ccstatusline:$HOME/.config/ccstatusline"
  )
fi
if uses codex; then
  mkdir -p "$HOME/.codex"
  AGENT_ARGS+=(-v "$HOME/.codex:$HOME/.codex")
fi
if uses opencode; then
  # Keep the host service registration and live database out of the container.
  for entry in CONFIG:.config DATA:.local/share CACHE:.cache STATE:.local/state; do
    name="XDG_${entry%%:*}_HOME"
    directory="${!name:-$HOME/${entry#*:}}"
    target="$directory/opencode"
    source="$target"
    [[ "$name" == XDG_CONFIG_HOME ]] || source="$directory/opencode-docker"
    mkdir -p "$source"
    AGENT_ARGS+=(-e "$name=$directory" -v "$source:$target")
  done
fi

# D-Bus: expose only desktop notifications from the host session bus, through a
# filtering proxy. The full bus would let the container run host commands
# (systemd --user, Flatpak HostCommand) and read the keyring. Use scoped
# --call/--broadcast rules, not --talk: --talk opens every object on the
# notification server's connection, which some desktops share with other services.
DBUS_DOCKER_ARGS=()
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]] && command -v xdg-dbus-proxy >/dev/null &&
   DBUS_PROXY_DIR="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/claude-docker-dbus.XXXXXX")"; then
  trap 'rm -rf "$DBUS_PROXY_DIR"' EXIT
  # The proxy writes one byte to the pipe when ready, and exits once this
  # script (and docker) close the read end.
  exec {DBUS_PROXY_FD}< <(exec xdg-dbus-proxy --fd=1 \
    "$DBUS_SESSION_BUS_ADDRESS" "$DBUS_PROXY_DIR/bus" \
    --filter \
    --call=org.freedesktop.Notifications=org.freedesktop.Notifications.*@/org/freedesktop/Notifications \
    --broadcast=org.freedesktop.Notifications=org.freedesktop.Notifications.*@/org/freedesktop/Notifications)
  if read -r -n 1 -t 5 -u "$DBUS_PROXY_FD" && [[ -S $DBUS_PROXY_DIR/bus ]]; then
    DBUS_DOCKER_ARGS=(
      -v "$DBUS_PROXY_DIR/bus:/run/user/$(id -u)/bus"
      -e "DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus"
    )
  else
    exec {DBUS_PROXY_FD}<&-
    echo "Warning: xdg-dbus-proxy did not start; desktop notifications disabled" >&2
  fi
fi

# GPU: host /usr already provides the driver libraries, so only the device nodes
# are needed. gVisor's nvproxy supports a fixed list of drivers, so GPU runs use
# runc even when gVisor is the default.
GPU_ARGS=()
if [[ -n $GPU ]]; then
  if [[ $DOCKER_RUNTIME == runsc ]]; then
    if [[ -n $RUNTIME_SET ]]; then
      echo "Error: --gpu does not work with --runtime runsc" >&2
      exit 1
    fi
    echo "Note: --gpu runs with runc, not gVisor" >&2
    DOCKER_RUNTIME=runc
  fi
  for dev in /dev/nvidia* /dev/dri; do
    if [[ -c $dev || -d $dev ]]; then GPU_ARGS+=(--device "$dev"); fi
  done
  if [[ ${#GPU_ARGS[@]} -eq 0 ]]; then
    echo "Error: --gpu: no GPU devices found" >&2
    exit 1
  fi
fi

# uv: binaries read-only, Pythons and cache read-write at the same paths, so a
# project .venv created on the host keeps working. Not all of ~/.local: that
# would hide the agents in the image and expose other apps' data.
UV_ARGS=()
if [[ -n $UV ]] && ! UV_BIN="$(command -v uv)"; then
  if [[ $UV == required ]]; then
    echo "Error: --uv: uv not found on the host" >&2
    exit 1
  fi
  UV=""
fi
if [[ -n $UV ]]; then
  UV_DIR="$(dirname "$(readlink -f "$UV_BIN")")"
  for bin in uv uvx; do
    if [[ -x $UV_DIR/$bin ]]; then UV_ARGS+=(-v "$UV_DIR/$bin:$HOME/.local/bin/$bin:ro"); fi
  done
  mkdir -p "$HOME/.local/share/uv" "$HOME/.cache/uv" "$HOME/.config/uv"
  UV_ARGS+=(
    -v "$HOME/.local/share/uv:$HOME/.local/share/uv"
    -v "$HOME/.cache/uv:$HOME/.cache/uv"
    -v "$HOME/.config/uv:$HOME/.config/uv:ro"
  )
fi

# Extra docker run flags from --docker-args and CLAUDE_DOCKER_EXTRA_ARGS.
# Split on whitespace without evaluating shell syntax.
ENV_DOCKER_ARGS=()
if [[ $DOCKER_ARGS == *$'\n'* ]]; then
  echo "Error: --docker-args and CLAUDE_DOCKER_EXTRA_ARGS must be a single line" >&2
  exit 1
fi
IFS=$' \t' read -r -a ENV_DOCKER_ARGS <<< "$DOCKER_ARGS"

# Container runtime from --runtime (runc, or runsc for gVisor).
RUNTIME_ARGS=()
[[ -z ${DOCKER_RUNTIME:-} ]] || RUNTIME_ARGS=(--runtime "$DOCKER_RUNTIME")

TTY_ARGS=(-i)
[[ ! -t 0 || ! -t 1 ]] || TTY_ARGS+=(-t)

docker --context "$DOCKER_CONTEXT" run "${RUNTIME_ARGS[@]}" "${TTY_ARGS[@]}" --rm --security-opt no-new-privileges "${CAP_ARGS[@]}" \
  --user "$CONTAINER_USER" \
  -e HOME="$HOME" \
  -e TERM="${TERM:-xterm-256color}" \
  -e COLORTERM \
  -e IS_SANDBOX=1 \
  -w "$WORK_DIR" \
  -v "$WORK_DIR:$WORK_DIR" \
  "${AGENT_ARGS[@]}" \
  -v /usr:/usr:ro \
  "${ALTERNATIVES[@]}" \
  "${DBUS_DOCKER_ARGS[@]}" \
  "${GPU_ARGS[@]}" \
  "${UV_ARGS[@]}" \
  "${ENV_DOCKER_ARGS[@]}" \
  "${CMD[@]}" claude-docker "$@"
